# ─── Database (Supabase Postgres) ─────────────────────────────────────────
# Supabase dashboard → Connect → "Transaction pooler" (port 6543).
# The direct db.<ref>.supabase.co host is IPv6-only and won't work on Vercel.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"
# "Session pooler" (port 5432) — used by `npm run db:seed` and `admin:create`.
DATABASE_URL_SESSION="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase (auth + storage) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── Site ─────────────────────────────────────────────────────────────────
# In development use the *.localhost host: Flitt's embedded checkout does not
# load on pages served from a bare "localhost".
NEXT_PUBLIC_SITE_URL=http://cinemaomy.localhost:3000

# ─── Flitt payments ───────────────────────────────────────────────────────
# Sandbox values from https://docs.flitt.com/api/testing/ — replace with your
# merchant ID and payment secret key (Flitt portal → Technical settings).
FLITT_MERCHANT_ID=1549901
FLITT_SECRET_KEY=test
